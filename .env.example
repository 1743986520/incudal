# Incudal 环境变量模板。复制为 .env 后填写所有必需的敏感值。
# scripts/init-env.sh 可为留空项生成随机值。

# ============ 数据库配置 ============
POSTGRES_USER=incudal
POSTGRES_PASSWORD=
POSTGRES_DB=incudal

# ============ Redis 配置 ============
REDIS_PASSWORD=

# ============ 应用安全配置（必须填写或由初始化脚本生成） ============
JWT_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
ADMIN_PASSWORD=

# ============ 应用配置 ============
APP_PORT=3000
LOG_LEVEL=info
DISABLE_REQUEST_LOG=true
FRONTEND_URL=
SITE_URL=

# Docker 部署使用的镜像；发布版本由 release.yml 推送。
INCUDAL_IMAGE=ghcr.io/1743986520/incudal:latest

# ============ 支付回调配置（可选） ============
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_CALLBACK_IP_WHITELIST=
PAYMENT_CALLBACK_SKIP_IP_WHITELIST=false

# ============ Agent Release 配置（可选） ============
INCUDAL_AGENT_RELEASE_URL=
INCUDAL_AGENT_RELEASE_REPOSITORY=
INCUDAL_AGENT_RELEASE_TOKEN=

# ============ 数据库与流量调优（可选） ============
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_CONNECTION_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000
TRAFFIC_CONCURRENCY_PER_HOST=10
TRAFFIC_HOST_CONCURRENCY=3
DB_WORKER_BACKOFF_MS=15000

# ============ 监控（可选） ============
ALERT_WEBHOOK_URL=
